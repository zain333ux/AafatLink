<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pk.edu.nu.aafatlink.ui.volunteer.VolunteerAssignmentsViewController"
      spacing="18" styleClass="content-area request-list-page">
    <padding><Insets top="28" right="30" bottom="32" left="30"/></padding>
    <HBox alignment="CENTER_LEFT">
        <VBox spacing="5"><Label text="Assignment response" styleClass="welcome-title"/><Label text="Review the assistance need, location and priority before accepting or declining." wrapText="true" styleClass="welcome-copy"/></VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="refreshButton" text="Refresh" onAction="#loadAssignments" styleClass="outline-button"/>
    </HBox>
    <ListView fx:id="noticeList" prefHeight="85" managed="false" visible="false"/>
    <SplitPane dividerPositions="0.53" VBox.vgrow="ALWAYS" styleClass="request-split-pane">
        <items>
            <StackPane styleClass="panel-card request-list-panel">
                <TableView fx:id="assignmentTable" styleClass="request-table">
                    <columns>
                        <TableColumn fx:id="assistanceColumn" text="Assistance" prefWidth="165"/>
                        <TableColumn fx:id="locationColumn" text="Location" prefWidth="150"/>
                        <TableColumn fx:id="priorityColumn" text="Priority" prefWidth="80"/>
                        <TableColumn fx:id="assignedColumn" text="Assigned" prefWidth="105"/>
                    </columns>
                </TableView>
                <VBox fx:id="emptyState" visible="false" managed="false" alignment="CENTER" spacing="10" styleClass="empty-state">
                    <Label text="No pending response" styleClass="empty-state-title"/>
                    <Label fx:id="emptyMessageLabel" text="No assignment currently needs your response." wrapText="true" textAlignment="CENTER" styleClass="empty-state-copy"/>
                </VBox>
            </StackPane>
            <StackPane minWidth="390">
                <VBox fx:id="detailPlaceholder" alignment="CENTER" spacing="10" styleClass="empty-state"><Label text="Select an assignment" styleClass="empty-state-title"/><Label text="Its request details and decision controls will appear here." wrapText="true" styleClass="empty-state-copy"/></VBox>
                <VBox fx:id="detailContent" visible="false" managed="false" spacing="16" styleClass="panel-card request-detail-panel">
                    <Label text="ASSIGNMENT DETAILS" styleClass="card-kicker"/>
                    <VBox spacing="4"><Label text="Request ID" styleClass="detail-label"/><Label fx:id="requestIdLabel" styleClass="request-id"/></VBox>
                    <VBox spacing="4"><Label text="Required assistance" styleClass="detail-label"/><Label fx:id="assistanceLabel" wrapText="true" styleClass="detail-value"/></VBox>
                    <VBox spacing="4"><Label text="Location" styleClass="detail-label"/><Label fx:id="locationLabel" wrapText="true" styleClass="detail-value"/></VBox>
                    <HBox spacing="8" alignment="CENTER_LEFT"><Label text="Priority" styleClass="detail-label"/><Label fx:id="priorityLabel" styleClass="status-chip"/></HBox>
                    <Separator/>
                    <VBox spacing="6"><Label text="Decline reason" styleClass="field-label"/><ComboBox fx:id="standardReasonBox" promptText="Choose a standard reason (optional)" maxWidth="Infinity" styleClass="form-control"/><TextArea fx:id="declineReasonArea" promptText="Required only when declining; you may edit the selected reason" prefRowCount="3" wrapText="true" styleClass="form-text-area"/></VBox>
                    <HBox spacing="10"><Button fx:id="acceptButton" text="Accept assignment" onAction="#acceptSelected" styleClass="primary-button"/><Button fx:id="declineButton" text="Decline" onAction="#declineSelected" styleClass="danger-button"/></HBox>
                    <Label fx:id="messageLabel" wrapText="true"/>
                </VBox>
            </StackPane>
        </items>
    </SplitPane>
</VBox>
