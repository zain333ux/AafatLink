<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pk.edu.nu.aafatlink.ui.access.AccessManagementViewController"
      spacing="18" styleClass="content-area request-list-page">
    <padding><Insets top="26" right="30" bottom="30" left="30"/></padding>
    <HBox alignment="CENTER_LEFT"><VBox spacing="5"><Label text="User access management" styleClass="welcome-title"/><Label text="Apply role, account-state and volunteer-approval rules with an immutable audit trail." wrapText="true" styleClass="welcome-copy"/></VBox><Region HBox.hgrow="ALWAYS"/><Button fx:id="refreshButton" text="Refresh" onAction="#loadUsers" styleClass="outline-button"/></HBox>
    <SplitPane dividerPositions="0.48" VBox.vgrow="ALWAYS" styleClass="request-split-pane">
        <items>
            <StackPane styleClass="panel-card request-list-panel">
                <TableView fx:id="userTable" styleClass="request-table">
                    <columns><TableColumn fx:id="nameColumn" text="User" prefWidth="155"/><TableColumn fx:id="roleColumn" text="Role" prefWidth="105"/><TableColumn fx:id="statusColumn" text="Status" prefWidth="100"/><TableColumn fx:id="approvalColumn" text="Approval" prefWidth="100"/></columns>
                </TableView>
                <VBox fx:id="emptyState" visible="false" managed="false" alignment="CENTER" spacing="10" styleClass="empty-state"><Label text="No accounts available" styleClass="empty-state-title"/><Label text="Demonstration mode does not load or change real user access." wrapText="true" textAlignment="CENTER" styleClass="empty-state-copy"/></VBox>
            </StackPane>
            <StackPane minWidth="480">
                <VBox fx:id="detailPlaceholder" alignment="CENTER" spacing="10" styleClass="empty-state"><Label text="Select a user" styleClass="empty-state-title"/><Label text="Current access, permissions and change controls will appear here." wrapText="true" styleClass="empty-state-copy"/></VBox>
                <VBox fx:id="detailContent" visible="false" managed="false" spacing="14" styleClass="panel-card request-detail-panel">
                    <Label text="ACCESS CONFIGURATION · UC12" styleClass="card-kicker"/>
                    <VBox spacing="3"><Label fx:id="nameLabel" styleClass="panel-title"/><Label fx:id="emailLabel" styleClass="helper-text"/></VBox>
                    <HBox spacing="12"><VBox spacing="5" HBox.hgrow="ALWAYS"><Label text="Role" styleClass="field-label"/><ComboBox fx:id="roleBox" maxWidth="Infinity"/></VBox><VBox spacing="5" HBox.hgrow="ALWAYS"><Label text="Account status" styleClass="field-label"/><ComboBox fx:id="statusBox" maxWidth="Infinity"/></VBox></HBox>
                    <VBox fx:id="approvalBox" spacing="5"><Label text="Volunteer approval" styleClass="field-label"/><ComboBox fx:id="approvalStatusBox" maxWidth="Infinity"/></VBox>
                    <VBox spacing="6"><Label text="Permissions granted by selected role" styleClass="field-label"/><ListView fx:id="permissionList" prefHeight="120"/></VBox>
                    <VBox spacing="5"><Label text="Administrative reason" styleClass="field-label"/><TextArea fx:id="reasonArea" promptText="Required for volunteer rejection; recorded for every change" prefRowCount="3" wrapText="true"/></VBox>
                    <Label text="Security rules block self-role changes, last-Administrator removal and access restriction while assignments are active." wrapText="true" styleClass="helper-text"/>
                    <Button fx:id="saveButton" text="Validate and save access" onAction="#saveAccess" styleClass="primary-button"/>
                    <Label fx:id="messageLabel" wrapText="true" styleClass="form-message"/>
                </VBox>
            </StackPane>
        </items>
    </SplitPane>
</VBox>
