<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pk.edu.nu.aafatlink.ui.volunteer.VolunteerReadinessViewController"
            fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">
    <VBox spacing="18" styleClass="content-area workflow-page">
        <padding><Insets top="28" right="26" bottom="32" left="26"/></padding>
        <HBox alignment="CENTER_LEFT" spacing="14">
            <VBox spacing="5">
                <Label text="Volunteer readiness" styleClass="welcome-title"/>
                <Label text="Keep your contact, availability, skills and service areas current for coordinator matching." wrapText="true" styleClass="welcome-copy"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="refreshButton" text="Refresh" onAction="#loadProfile" styleClass="outline-button"/>
        </HBox>
        <HBox spacing="18" alignment="TOP_LEFT">
            <VBox spacing="16" styleClass="panel-card" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="4"><Label text="Readiness profile" styleClass="card-kicker"/><Label text="Operational details" styleClass="panel-title"/></VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="approvalStatusLabel" text="Loading" styleClass="status-chip"/>
                </HBox>
                <GridPane hgap="16" vgap="12">
                    <columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints>
                    <VBox spacing="6" GridPane.columnIndex="0"><Label text="Contact number" styleClass="field-label"/><TextField fx:id="contactField" promptText="+92 300 1234567" styleClass="form-control"/></VBox>
                    <VBox spacing="6" GridPane.columnIndex="1"><Label text="Availability" styleClass="field-label"/><ComboBox fx:id="availabilityBox" maxWidth="Infinity" styleClass="form-control"/></VBox>
                </GridPane>
                <VBox spacing="6"><Label text="Availability notes" styleClass="field-label"/><TextArea fx:id="notesArea" promptText="Optional shift or travel notes" prefRowCount="3" wrapText="true" styleClass="form-text-area"/></VBox>
                <Label text="Administrator approval is independent of these updates. An approved volunteer must also be Available to appear in volunteer searches." wrapText="true" styleClass="helper-text"/>
            </VBox>
            <VBox spacing="14" styleClass="panel-card" minWidth="360" HBox.hgrow="ALWAYS">
                <Label text="Assignment matching" styleClass="card-kicker"/>
                <Label text="Select one or more items in each list." wrapText="true" styleClass="panel-subtitle"/>
                <GridPane hgap="14">
                    <columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints>
                    <VBox spacing="6" GridPane.columnIndex="0"><Label text="Response skills" styleClass="field-label"/><ListView fx:id="skillsList" prefHeight="210"/></VBox>
                    <VBox spacing="6" GridPane.columnIndex="1"><Label text="Service areas" styleClass="field-label"/><ListView fx:id="serviceAreasList" prefHeight="210"/></VBox>
                </GridPane>
            </VBox>
        </HBox>
        <HBox alignment="CENTER_RIGHT" spacing="14">
            <Label fx:id="messageLabel" wrapText="true" HBox.hgrow="ALWAYS"/>
            <Button fx:id="saveButton" text="Save readiness profile" onAction="#saveProfile" styleClass="primary-button"/>
        </HBox>
    </VBox>
</ScrollPane>
