<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pk.edu.nu.aafatlink.ui.shell.AppShellController" styleClass="shell-root">
    <left>
        <VBox prefWidth="258.0" minWidth="238.0" styleClass="sidebar">
            <padding><Insets top="28.0" right="20.0" bottom="24.0" left="20.0" /></padding>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <StackPane minWidth="40.0" minHeight="40.0" styleClass="brand-mark-small">
                    <Label text="A" styleClass="brand-mark-text-small" />
                </StackPane>
                <VBox spacing="0.0">
                    <Label text="AafatLink" styleClass="brand-name-light-small" />
                    <Label text="RESPONSE SYSTEM" styleClass="brand-kicker-light" />
                </VBox>
            </HBox>
            <Label text="WORKSPACE" styleClass="nav-section-label">
                <VBox.margin><Insets top="32.0" bottom="10.0" /></VBox.margin>
            </Label>
            <VBox fx:id="navigationBox" spacing="6.0" />
            <Region VBox.vgrow="ALWAYS" />
            <VBox spacing="10.0" styleClass="demo-notice-dark">
                <Label text="DEMONSTRATION" styleClass="demo-notice-title" />
                <Label text="Preview navigation only. No operational data is connected."
                       wrapText="true" styleClass="demo-notice-copy" />
            </VBox>
            <Button text="Sign out" onAction="#logout" maxWidth="Infinity" styleClass="logout-button">
                <VBox.margin><Insets top="16.0" /></VBox.margin>
            </Button>
        </VBox>
    </left>
    <top>
        <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="topbar">
            <padding><Insets top="18.0" right="30.0" bottom="18.0" left="30.0" /></padding>
            <VBox spacing="3.0">
                <Label fx:id="pageTitleLabel" text="Dashboard" styleClass="page-title" />
                <Label fx:id="pageDescriptionLabel" text="Role-aware operational overview" styleClass="page-subtitle" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <VBox alignment="CENTER_RIGHT" spacing="3.0">
                <Label fx:id="userNameLabel" text="Demo User" styleClass="user-name" />
                <Label fx:id="roleLabel" text="Requester" styleClass="role-pill" />
            </VBox>
            <StackPane minWidth="42.0" minHeight="42.0" styleClass="avatar">
                <Label text="DA" styleClass="avatar-text" />
            </StackPane>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">
            <VBox spacing="24.0" styleClass="content-area">
                <padding><Insets top="32.0" right="34.0" bottom="40.0" left="34.0" /></padding>
                <VBox spacing="8.0">
                    <Label fx:id="welcomeLabel" text="Good to see you." styleClass="welcome-title" />
                    <Label text="This Phase 1 shell establishes the visual system and role boundaries for upcoming workflows."
                           wrapText="true" styleClass="welcome-copy" />
                </VBox>

                <HBox spacing="12.0" styleClass="foundation-banner">
                    <StackPane minWidth="38.0" minHeight="38.0" styleClass="info-icon-circle">
                        <Label text="i" styleClass="info-icon-text" />
                    </StackPane>
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                        <Label text="Phase 1 foundation is active" styleClass="banner-title" />
                        <Label text="All figures below are demonstration labels, not live disaster-response statistics."
                               wrapText="true" styleClass="banner-copy" />
                    </VBox>
                </HBox>

                <FlowPane hgap="16.0" vgap="16.0" prefWrapLength="820.0">
                    <VBox prefWidth="236.0" spacing="14.0" styleClass="summary-card">
                        <Label text="MANDATORY BASELINE" styleClass="card-kicker" />
                        <Label text="12 use cases" styleClass="card-value" />
                        <Label text="Traceability started" styleClass="card-caption" />
                    </VBox>
                    <VBox prefWidth="236.0" spacing="14.0" styleClass="summary-card">
                        <Label text="CURRENT MODE" styleClass="card-kicker" />
                        <Label text="Demo only" styleClass="card-value" />
                        <Label text="No remote writes" styleClass="card-caption" />
                    </VBox>
                    <VBox prefWidth="236.0" spacing="14.0" styleClass="summary-card">
                        <Label text="SECURITY POSTURE" styleClass="card-kicker" />
                        <Label text="Public config" styleClass="card-value" />
                        <Label text="No privileged keys" styleClass="card-caption" />
                    </VBox>
                </FlowPane>

                <VBox spacing="18.0" styleClass="panel-card">
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="4.0">
                            <Label text="Implementation roadmap" styleClass="panel-title" />
                            <Label text="Verified progress toward the academic and portfolio baseline" styleClass="panel-subtitle" />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label text="FOUNDATION" styleClass="status-chip" />
                    </HBox>
                    <HBox spacing="14.0">
                        <VBox HBox.hgrow="ALWAYS" spacing="7.0" styleClass="roadmap-item roadmap-item-active">
                            <Label text="01" styleClass="roadmap-number" />
                            <Label text="Application foundation" styleClass="roadmap-title" />
                            <Label text="In progress" styleClass="roadmap-state-active" />
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" spacing="7.0" styleClass="roadmap-item">
                            <Label text="02" styleClass="roadmap-number" />
                            <Label text="Database &amp; security" styleClass="roadmap-title" />
                            <Label text="Next" styleClass="roadmap-state" />
                        </VBox>
                        <VBox HBox.hgrow="ALWAYS" spacing="7.0" styleClass="roadmap-item">
                            <Label text="03" styleClass="roadmap-number" />
                            <Label text="Authentication" styleClass="roadmap-title" />
                            <Label text="Planned" styleClass="roadmap-state" />
                        </VBox>
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
