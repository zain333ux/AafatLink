<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pk.edu.nu.aafatlink.ui.shell.AppShellController" styleClass="shell-root">
    <left>
        <VBox prefWidth="214" minWidth="214" styleClass="sidebar">
            <padding><Insets top="22" right="12" bottom="14" left="12" /></padding>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <fx:include source="aafatlink-mark.fxml"/>
                <Label text="AafatLink" styleClass="brand-name-light-small" />
            </HBox>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="navigation-scroll">
                <VBox.margin><Insets top="26" bottom="14"/></VBox.margin>
                <VBox fx:id="navigationBox" spacing="3"/>
            </ScrollPane>
            <Button fx:id="logoutButton" text="Sign out" onAction="#logout" maxWidth="Infinity" styleClass="logout-button">
                <VBox.margin><Insets bottom="12.0" /></VBox.margin>
            </Button>
            <Label fx:id="demoNoticeLabel" text="Read-only demo" styleClass="demo-notice" />
          </VBox>
    </left>
    <center>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="18.0" styleClass="topbar">
                <padding><Insets top="12" right="24" bottom="12" left="26" /></padding>
                <Label fx:id="pageTitleLabel" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS" />
                <VBox alignment="CENTER_RIGHT" spacing="3.0">
                    <Label fx:id="userNameLabel" text="Demo User" styleClass="user-name" />
                    <Label fx:id="roleLabel" text="Requester" styleClass="role-pill" />
                  </VBox>
                <StackPane minWidth="34" minHeight="34" styleClass="avatar">
                    <Label fx:id="avatarLabel" styleClass="avatar-text" />
                </StackPane>
            </HBox>
            <StackPane fx:id="contentHost" VBox.vgrow="ALWAYS" styleClass="shell-content-host" />
        </VBox>
    </center>
</BorderPane>
