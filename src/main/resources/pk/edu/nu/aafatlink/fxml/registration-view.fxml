<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import pk.edu.nu.aafatlink.ui.brand.ContourArtwork?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pk.edu.nu.aafatlink.ui.auth.RegistrationViewController" styleClass="auth-root">
    <left>
        <VBox prefWidth="432" minWidth="350" spacing="20" styleClass="auth-brand-panel">
            <padding><Insets top="34" right="34" bottom="34" left="34"/></padding>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <fx:include source="aafatlink-mark.fxml"/>
                <Label text="AafatLink" styleClass="brand-name-light"/>
            </HBox>
            <Region minHeight="22" maxHeight="72" VBox.vgrow="ALWAYS"/>
            <Label text="Create an&#10;account" wrapText="true" styleClass="auth-hero-title"/>
            <Label text="Choose Requester to seek assistance or Volunteer to offer help. Volunteers need approval before they can receive assignments." wrapText="true" styleClass="auth-hero-copy"/>
            <ContourArtwork prefHeight="180" minHeight="120" maxHeight="220"
                            VBox.vgrow="ALWAYS" styleClass="auth-contours"/>
        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" styleClass="auth-scroll">
            <StackPane styleClass="auth-content">
                <VBox maxWidth="500.0" spacing="16.0" styleClass="auth-card">
                    <VBox spacing="6.0">

                        <Label text="Create your account" styleClass="auth-title" />
                        <Label text="Use an email address you can verify." styleClass="auth-subtitle" />
                    </VBox>
                    <VBox spacing="7.0">
                        <Label text="Account type" styleClass="field-label" />
                        <ComboBox fx:id="accountTypeBox" maxWidth="Infinity" styleClass="role-combo" />
                    </VBox>
                    <VBox spacing="7.0">
                        <Label text="Full name" styleClass="field-label" />
                        <TextField fx:id="displayNameField" promptText="Your name" styleClass="text-input" />
                    </VBox>
                    <VBox spacing="7.0">
                        <Label text="Email address" styleClass="field-label" />
                        <TextField fx:id="emailField" promptText="you@example.com" styleClass="text-input" />
                    </VBox>
                    <HBox spacing="12.0">
                        <VBox spacing="7.0" HBox.hgrow="ALWAYS">
                            <Label text="Password" styleClass="field-label" />
                            <PasswordField fx:id="passwordField" promptText="At least 8 characters" styleClass="text-input" />
                        </VBox>
                        <VBox spacing="7.0" HBox.hgrow="ALWAYS">
                            <Label text="Confirm password" styleClass="field-label" />
                            <PasswordField fx:id="confirmPasswordField" promptText="Repeat password"
                                           onAction="#register" styleClass="text-input" />
                        </VBox>
                    </HBox>
                    <Button fx:id="registerButton" text="Create account" onAction="#register"
                            maxWidth="Infinity" styleClass="primary-button" />
                    <Label fx:id="registrationMessageLabel" text="" wrapText="true" styleClass="form-message" />
                    <Button text="Back to sign in" onAction="#backToSignIn" maxWidth="Infinity" styleClass="text-button" />
                </VBox>
            </StackPane>
        </ScrollPane>
    </center>
</BorderPane>
