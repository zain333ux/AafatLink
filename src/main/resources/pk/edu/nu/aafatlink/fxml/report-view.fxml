<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pk.edu.nu.aafatlink.ui.reporting.ReportViewController"
      spacing="18" styleClass="content-area request-list-page">
    <padding><Insets top="26" right="30" bottom="30" left="30"/></padding>
    <VBox spacing="5"><Label text="Disaster response reports" styleClass="welcome-title"/><Label text="Choose a report to review request, assignment and response activity." wrapText="true" styleClass="welcome-copy"/></VBox>
    <VBox spacing="14" styleClass="panel-card">
        <Label text="REPORT PARAMETERS" styleClass="card-kicker"/>
        <FlowPane hgap="12" vgap="12">
            <VBox spacing="5" prefWidth="220"><Label text="Report type" styleClass="field-label"/><ComboBox fx:id="reportTypeBox" maxWidth="Infinity" styleClass="form-control"/></VBox>
            <VBox spacing="5" prefWidth="150"><Label text="Start date" styleClass="field-label"/><DatePicker fx:id="startDatePicker" maxWidth="Infinity"/></VBox>
            <VBox spacing="5" prefWidth="150"><Label text="End date" styleClass="field-label"/><DatePicker fx:id="endDatePicker" maxWidth="Infinity"/></VBox>
            <VBox spacing="5" prefWidth="165"><Label text="Disaster type" styleClass="field-label"/><ComboBox fx:id="disasterTypeBox" promptText="All types" maxWidth="Infinity"/></VBox>
            <VBox spacing="5" prefWidth="190"><Label text="Request status" styleClass="field-label"/><ComboBox fx:id="statusBox" promptText="All statuses" maxWidth="Infinity"/></VBox>
            <VBox spacing="5" prefWidth="150"><Label text="Priority" styleClass="field-label"/><ComboBox fx:id="priorityBox" promptText="All priorities" maxWidth="Infinity"/></VBox>
            <VBox spacing="5" prefWidth="190"><Label text="Service area" styleClass="field-label"/><ComboBox fx:id="serviceAreaBox" promptText="All areas" maxWidth="Infinity"/></VBox>
        </FlowPane>
        <HBox spacing="10"><Button fx:id="generateButton" text="Generate report" onAction="#generateReport" styleClass="primary-button"/><Button text="Clear filters" onAction="#clearFilters" styleClass="outline-button"/><Region HBox.hgrow="ALWAYS"/><Button fx:id="exportButton" text="Export CSV" onAction="#exportCsv" styleClass="secondary-button"/></HBox>
    </VBox>
    <FlowPane fx:id="summaryPane" hgap="10" vgap="8"/>
    <StackPane VBox.vgrow="ALWAYS" styleClass="panel-card request-list-panel">
        <TableView fx:id="reportTable" styleClass="request-table"/>
        <VBox fx:id="emptyState" alignment="CENTER" spacing="10" styleClass="empty-state"><Label fx:id="emptyTitle" text="Choose a report" styleClass="empty-state-title"/><Label fx:id="emptyCopy" text="Select filters and generate a report." wrapText="true" textAlignment="CENTER" styleClass="empty-state-copy"/></VBox>
    </StackPane>
    <Label fx:id="messageLabel" wrapText="true" styleClass="form-message"/>
</VBox>
