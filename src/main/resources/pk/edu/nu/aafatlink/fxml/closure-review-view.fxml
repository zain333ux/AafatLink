<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pk.edu.nu.aafatlink.ui.request.ClosureReviewViewController"
      spacing="18" styleClass="content-area request-list-page">
    <padding><Insets top="28" right="30" bottom="32" left="30"/></padding>
    <HBox alignment="CENTER_LEFT">
        <VBox spacing="5"><Label text="Closure review" styleClass="welcome-title"/><Label text="Confirm delivered assistance or return incomplete work with an auditable reason." wrapText="true" styleClass="welcome-copy"/></VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="refreshButton" text="Refresh" onAction="#loadRequests" styleClass="outline-button"/>
    </HBox>
    <SplitPane dividerPositions="0.38" VBox.vgrow="ALWAYS" styleClass="request-split-pane">
        <items>
            <StackPane styleClass="panel-card request-list-panel">
                <TableView fx:id="requestTable" styleClass="request-table">
                    <columns>
                        <TableColumn fx:id="assistanceColumn" text="Assistance" prefWidth="150"/>
                        <TableColumn fx:id="locationColumn" text="Location" prefWidth="135"/>
                        <TableColumn fx:id="priorityColumn" text="Priority" prefWidth="80"/>
                    </columns>
                </TableView>
                <VBox fx:id="emptyState" visible="false" managed="false" alignment="CENTER" spacing="10" styleClass="empty-state">
                    <Label text="Closure queue is clear" styleClass="empty-state-title"/>
                    <Label text="No request is awaiting closure review." wrapText="true" textAlignment="CENTER" styleClass="empty-state-copy"/>
                </VBox>
            </StackPane>
            <StackPane minWidth="520">
                <VBox fx:id="detailPlaceholder" alignment="CENTER" spacing="10" styleClass="empty-state"><Label text="Select a request" styleClass="empty-state-title"/><Label text="Completion remarks, evidence and decision controls will appear here." wrapText="true" styleClass="empty-state-copy"/></VBox>
                <ScrollPane fx:id="detailScroll" visible="false" managed="false" fitToWidth="true" styleClass="detail-scroll">
                    <content>
                        <VBox fx:id="detailContent" spacing="16" styleClass="panel-card request-detail-panel">
                            <Label text="CLOSURE CONTEXT · UC06" styleClass="card-kicker"/>
                            <VBox spacing="4"><Label text="Request ID" styleClass="detail-label"/><Label fx:id="requestIdLabel" styleClass="request-id"/></VBox>
                            <VBox spacing="4"><Label text="Required assistance" styleClass="detail-label"/><Label fx:id="assistanceLabel" wrapText="true" styleClass="detail-value"/></VBox>
                            <VBox spacing="4"><Label text="Location" styleClass="detail-label"/><Label fx:id="locationLabel" wrapText="true" styleClass="detail-value"/></VBox>
                            <Separator/>
                            <VBox spacing="6"><Label text="Volunteer completion remarks" styleClass="field-label"/><Label fx:id="completionRemarksLabel" wrapText="true" styleClass="detail-value"/></VBox>
                            <VBox spacing="7"><Label text="Progress history" styleClass="field-label"/><ListView fx:id="progressList" prefHeight="105"/></VBox>
                            <VBox spacing="7"><Label text="Completion evidence" styleClass="field-label"/><ListView fx:id="evidenceList" prefHeight="82"/></VBox>
                            <VBox spacing="10" styleClass="decision-panel">
                                <Label text="COORDINATOR DECISION" styleClass="card-kicker"/>
                                <TextArea fx:id="remarksArea" promptText="Closing remarks are optional; a rework reason is mandatory" prefRowCount="3" wrapText="true" styleClass="form-text-area"/>
                                <HBox spacing="10"><Button fx:id="approveButton" text="Approve closure" onAction="#approveClosure" styleClass="primary-button"/><Button fx:id="reworkButton" text="Return for rework" onAction="#returnForRework" styleClass="danger-button"/></HBox>
                            </VBox>
                            <Label fx:id="messageLabel" wrapText="true" styleClass="form-message"/>
                        </VBox>
                    </content>
                </ScrollPane>
            </StackPane>
        </items>
    </SplitPane>
</VBox>
