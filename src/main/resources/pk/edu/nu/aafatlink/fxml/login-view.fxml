<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import pk.edu.nu.aafatlink.ui.brand.ContourArtwork?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pk.edu.nu.aafatlink.ui.auth.LoginViewController" styleClass="auth-root">
    <left>
        <VBox prefWidth="432" minWidth="350" spacing="20" styleClass="auth-brand-panel">
            <padding><Insets top="34" right="34" bottom="34" left="34"/></padding>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <fx:include source="aafatlink-mark.fxml"/>
                <Label text="AafatLink" styleClass="brand-name-light"/>
            </HBox>
            <Region minHeight="22" maxHeight="72" VBox.vgrow="ALWAYS"/>
            <Label text="Disaster&#10;response" wrapText="true" styleClass="auth-hero-title"/>
            <Label text="Request assistance, coordinate volunteers and track work through completion." wrapText="true" styleClass="auth-hero-copy"/>
            <ContourArtwork prefHeight="180" minHeight="120" maxHeight="220"
                            VBox.vgrow="ALWAYS" styleClass="auth-contours"/>
        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" styleClass="auth-scroll">
            <StackPane styleClass="auth-content">
                <VBox maxWidth="470.0" spacing="12" styleClass="auth-card">
                    <Label text="Sign in" styleClass="auth-title"/>
                    <Label fx:id="configurationModeLabel" text="Demonstration mode" styleClass="helper-text"/>

                    <VBox spacing="9.0">
                        <Label text="Email address" styleClass="field-label" />
                        <TextField fx:id="emailField" promptText="you@example.com" disable="true" styleClass="text-input" />
                    </VBox>
                    <VBox spacing="9.0">
                        <Label text="Password" styleClass="field-label" />
                        <PasswordField fx:id="passwordField" promptText="••••••••" disable="true"
                                       onAction="#signIn" styleClass="text-input" />
                    </VBox>
                    <Button fx:id="signInButton" text="Sign-in unavailable" disable="true"
                            onAction="#signIn" maxWidth="Infinity" styleClass="primary-button" />
                    <Label fx:id="loginMessageLabel" text="" wrapText="true" styleClass="form-message" />
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Button fx:id="registrationButton" text="Create an account" onAction="#openRegistration"
                                maxWidth="Infinity" styleClass="text-button" />
                        <Button fx:id="recoveryButton" text="Forgot your password?" onAction="#openPasswordRecovery"
                                maxWidth="Infinity" styleClass="text-button" />
                    </HBox>

                    <VBox spacing="10" styleClass="demo-entry">
                        <Label text="Read-only demo" styleClass="panel-title"/>
                        <HBox spacing="9" alignment="CENTER_LEFT">
                            <ComboBox fx:id="demoRoleBox" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                      accessibleText="Demo role" styleClass="role-combo"/>
                            <Button text="Open demonstration workspace" onAction="#openDemonstrationWorkspace"
                                    styleClass="outline-button"/>
                        </HBox>
                    </VBox>
                </VBox>
            </StackPane>
        </ScrollPane>
    </center>
</BorderPane>
