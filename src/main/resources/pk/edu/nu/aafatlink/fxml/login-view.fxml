<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pk.edu.nu.aafatlink.ui.auth.LoginViewController" styleClass="auth-root">
    <left>
        <VBox prefWidth="460.0" minWidth="390.0" spacing="28.0" styleClass="auth-brand-panel">
            <padding><Insets top="48.0" right="48.0" bottom="40.0" left="48.0" /></padding>
            <HBox alignment="CENTER_LEFT" spacing="14.0">
                <StackPane minWidth="46.0" minHeight="46.0" styleClass="brand-mark">
                    <Label text="A" styleClass="brand-mark-text" />
                </StackPane>
                <VBox spacing="1.0">
                    <Label text="AafatLink" styleClass="brand-name-light" />
                    <Label text="RESPONSE COORDINATION" styleClass="brand-kicker-light" />
                </VBox>
            </HBox>
            <Region VBox.vgrow="ALWAYS" />
            <VBox spacing="16.0">
                <Label text="Help reaches people faster when every response is connected."
                       wrapText="true" styleClass="auth-hero-title" />
                <Label text="A shared operational workspace for assistance requests, volunteer readiness and accountable disaster response."
                       wrapText="true" styleClass="auth-hero-copy" />
            </VBox>
            <VBox spacing="13.0">
                <Label text="✓  Traceable request decisions" styleClass="feature-line" />
                <Label text="✓  Role-based coordination" styleClass="feature-line" />
                <Label text="✓  Secure workflow foundation" styleClass="feature-line" />
            </VBox>
            <Region VBox.vgrow="ALWAYS" />
            <Label text="FAST NUCES Islamabad · Software Design and Analysis" wrapText="true"
                   styleClass="auth-footer-text" />
        </VBox>
    </left>
    <center>
        <StackPane styleClass="auth-content">
            <VBox maxWidth="470.0" spacing="22.0" styleClass="auth-card">
                <VBox spacing="7.0">
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label text="FOUNDATION PREVIEW" styleClass="eyebrow" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="configurationModeLabel" text="Demonstration mode" styleClass="status-chip" />
                    </HBox>
                    <Label text="Welcome to AafatLink" styleClass="auth-title" />
                    <Label text="Explore the professional application shell while secure Supabase authentication is connected in Phase 3."
                           wrapText="true" styleClass="auth-subtitle" />
                </VBox>

                <VBox spacing="9.0">
                    <Label text="Email address" styleClass="field-label" />
                    <TextField promptText="you@example.com" disable="true" styleClass="text-input" />
                </VBox>
                <VBox spacing="9.0">
                    <Label text="Password" styleClass="field-label" />
                    <PasswordField promptText="••••••••" disable="true" styleClass="text-input" />
                </VBox>
                <Button text="Sign in securely (available in Phase 3)" disable="true" maxWidth="Infinity"
                        styleClass="primary-button" />

                <HBox alignment="CENTER" spacing="14.0">
                    <Separator HBox.hgrow="ALWAYS" />
                    <Label text="DEMONSTRATION ACCESS" styleClass="separator-label" />
                    <Separator HBox.hgrow="ALWAYS" />
                </HBox>

                <VBox spacing="9.0">
                    <Label text="Preview as role" styleClass="field-label" />
                    <ComboBox fx:id="demoRoleBox" maxWidth="Infinity" styleClass="role-combo" />
                </VBox>
                <Button text="Open demonstration workspace" onAction="#openDemonstrationWorkspace"
                        maxWidth="Infinity" styleClass="secondary-button" />
                <Label text="Demonstration access contains no real accounts, credentials or operational data."
                       wrapText="true" styleClass="helper-text" />
            </VBox>
        </StackPane>
    </center>
</BorderPane>
