<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="pk.edu.nu.aafatlink.ui.shell.DashboardViewController"
    fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">
    <VBox spacing="16" styleClass="content-area">
        <padding><Insets top="24" right="26" bottom="32" left="26"/></padding>
        <VBox spacing="16" styleClass="dispatch-heading">
            <Label fx:id="heading" styleClass="dispatch-title" wrapText="true"/>
            <FlowPane fx:id="actions" hgap="10" vgap="8"/>
        </VBox>
        <VBox>
            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="dispatch-toolbar">
                <Label text="Work queues" styleClass="panel-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="message" styleClass="helper-text" wrapText="true"/>
                <Button fx:id="refresh" styleClass="text-button" text="Refresh" onAction="#reload"/>
            </HBox>
            <VBox fx:id="queueList"/>
        </VBox>
    </VBox>
</ScrollPane>
