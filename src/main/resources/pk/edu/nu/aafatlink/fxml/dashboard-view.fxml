<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="pk.edu.nu.aafatlink.ui.shell.DashboardViewController"
    fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll">
    <VBox spacing="16" styleClass="content-area">
        <padding><Insets top="24" right="30" bottom="32" left="30"/></padding>
        <Label fx:id="heading" styleClass="welcome-title" wrapText="true"/>
        <FlowPane fx:id="actions" hgap="12" vgap="8"/>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Button fx:id="refresh" styleClass="outline-button" text="Refresh" onAction="#reload"/>
            <Label fx:id="message" styleClass="helper-text" wrapText="true"/>
        </HBox>
        <FlowPane fx:id="cards" hgap="14" vgap="14"/>
    </VBox>
</ScrollPane>
