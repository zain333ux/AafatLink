<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pk.edu.nu.aafatlink.ui.auth.PasswordRecoveryViewController" styleClass="auth-root">
    <left>
        <VBox prefWidth="460.0" minWidth="390.0" spacing="28.0" styleClass="auth-brand-panel">
            <padding><Insets top="48.0" right="48.0" bottom="40.0" left="48.0" /></padding>
            <Label text="AafatLink" styleClass="brand-name-light" />
            <Region VBox.vgrow="ALWAYS" />
            <VBox spacing="16.0">
                <Label text="Recover access without exposing your password."
                       wrapText="true" styleClass="auth-hero-title" />
                <Label text="A one-use PKCE link returns only to this AafatLink session on your computer."
                       wrapText="true" styleClass="auth-hero-copy" />
            </VBox>
            <Region VBox.vgrow="ALWAYS" />
            <Label text="The recovery attempt expires after 10 minutes." wrapText="true"
                   styleClass="auth-footer-text" />
        </VBox>
    </left>
    <center>
        <StackPane styleClass="auth-content">
            <VBox maxWidth="470.0" spacing="20.0" styleClass="auth-card">
                <VBox spacing="7.0">
                    <Label text="SECURE ACCOUNT RECOVERY" styleClass="eyebrow" />
                    <Label text="Choose a new password" styleClass="auth-title" />
                    <Label text="Enter your verified email and new password. Then open Gmail on this same computer and click the newest recovery link once. Do not open it on your phone."
                           wrapText="true" styleClass="auth-subtitle" />
                </VBox>
                <VBox spacing="9.0">
                    <Label text="Email address" styleClass="field-label" />
                    <TextField fx:id="emailField" promptText="you@example.com" styleClass="text-input" />
                </VBox>
                <VBox spacing="9.0">
                    <Label text="New password" styleClass="field-label" />
                    <PasswordField fx:id="passwordField" promptText="At least 8 characters" styleClass="text-input" />
                </VBox>
                <VBox spacing="9.0">
                    <Label text="Confirm new password" styleClass="field-label" />
                    <PasswordField fx:id="confirmPasswordField" promptText="Repeat the password"
                                   onAction="#recover" styleClass="text-input" />
                </VBox>
                <Button fx:id="recoverButton" text="Send recovery email" onAction="#recover"
                        maxWidth="Infinity" styleClass="primary-button" />
                <Label fx:id="recoveryMessageLabel" text="" wrapText="true" styleClass="form-message" />
                <Button fx:id="backButton" text="Back to sign in" onAction="#backToSignIn"
                        maxWidth="Infinity" styleClass="text-button" />
            </VBox>
        </StackPane>
    </center>
</BorderPane>
